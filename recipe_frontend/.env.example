# Environment variables required by Recipe Explorer frontend
# Set these in your .env file at the project root (same folder as package.json)

# Supabase Project URL (Settings -> API -> Project URL)
REACT_APP_SUPABASE_URL=
# Supabase Anon Public Key (Settings -> API -> Project API keys -> anon public)
REACT_APP_SUPABASE_KEY=

# The site URL used for auth redirects (used by Supabase OTP email login)
# Example for local dev:
# REACT_APP_SITE_URL=http://localhost:3000
REACT_APP_SITE_URL=
